%%html
<style>
  /* 부모에게 flex 지시 */
  .container {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  /* 각 박스 공통 스타일 */
  .container > div {
    color: white;
    padding: 12px 20px;
    border-radius: 6px;
    font-weight: bold;
  }

  /* 박스별 개별 색상 지정 */
  .container > div:nth-child(1) { background-color: #00a8cc; } /* 박스1 */
  .container > div:nth-child(2) { background-color: #006680; } /* 박스2 */
  .container > div:nth-child(3) { background-color: #12192c; } /* 박스3 */
</style>

<!-- HTML: 박스 3개를 감싸는 부모 -->
<div class="container">
  <div>박스1</div>
  <div>박스2</div>
  <div>박스3</div>
</div>

%%html

<style>
.box {
    width: 120px;
    padding: 40px;
    border: 10px dashed #FF6B57;
    margin: 50px;
    background: #FFF3E9;
}

.content {
    background: #0EA5C4;
    color: #fff;
    text-align: center;
    padding: 14px 0;
}

.outer {
    background: #F1F5FB;
}
</style>

<div class="outer">
    <div class="box">
        <div class="content">content</div>
    </div>
</div>

